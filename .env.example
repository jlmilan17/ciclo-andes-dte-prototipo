# Base de datos (PostgreSQL 16 en Docker Compose)
DATABASE_URL=postgres://ciclo:ciclo@localhost:5433/ciclo_andes
DATABASE_URL_TEST=postgres://ciclo:ciclo@localhost:5433/ciclo_andes_test

# API de negocio
API_PORT=4000
JWT_SECRET=change-me-dev-only
JWT_TTL_MINUTES=30

# Secreto para cifrar en reposo la llave privada del certificado de PRUEBAS (AES-256-GCM)
CERT_SECRET=change-me-dev-only-32-bytes-min

# Simulador del Ministerio de Hacienda (servicio separado, NO es el MH real)
MH_SIM_PORT=4100
MH_SIM_URL=http://localhost:4100/mh-sim

# Herramientas de demostración (selector de rol, panel de simulación)
DEMO_MODE=true

# Zonas grises (valores provisionales, ver docs/ZONAS-GRISES.md)
RETENTION_APPLIES_TO=receptor
INVALIDATION_WINDOW_HOURS=24
BATCH_MAX_DOCUMENTS=100
CONTINGENCY_POLL_SECONDS=60
