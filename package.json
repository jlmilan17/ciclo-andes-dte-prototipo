{
  "name": "ciclo-andes-dte-prototipo",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "mh-sim",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w server",
    "seed": "npm run seed -w server",
    "dev": "concurrently -k -n mh,api,web -c yellow,cyan,green \"npm run dev -w mh-sim\" \"npm run dev -w server\" \"npm run dev -w web\"",
    "start:demo": "npm run db:up && npm run db:migrate && npm run seed && npm run dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "eslint": "^10.13.0",
    "@eslint/js": "^10.0.0",
    "typescript-eslint": "^8.72.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "concurrently": "^9.2.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.0",
    "vitest": "^4.1.12",
    "tsx": "^4.23.15"
  },
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  }
}
